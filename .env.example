# --- Taiga connection -------------------------------------------------------
# Self-hosted: https://taiga.example.com   taiga.io cloud: https://api.taiga.io
TAIGA_URL=https://taiga.example.com

# Credentials for the agent's Taiga account (create a dedicated user).
TAIGA_USERNAME=my-agent
TAIGA_PASSWORD=change-me
# ...or an auth token instead of username/password (required for taiga.io
# accounts that sign in via GitHub/GitLab/Google and have no password set):
#TAIGA_TOKEN=

# --- MCP server (HTTP mode) -------------------------------------------------
# Full-access bearer token. Generate one: openssl rand -hex 24
MCP_AUTH_TOKEN=change-me

# Scoped collaborator tokens: label:token:project_id:epic_id[,epic_id...],
# ';'-separated. Each token confines its holder to those epics (stories +
# tagged bugs). One epic or several per token.
#MCP_SCOPED_TOKENS=alex:3f8a...:2:117;vendor:b41c...:3:99,104
